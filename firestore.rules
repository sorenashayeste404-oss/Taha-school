rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Only a Firebase Auth user whose own /admins/{uid} document
    // explicitly grants active admin access can modify data.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == "admin"
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // Public academic data: students can read; only admins can write.
    match /classes/{classId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /dailyTasks/{taskId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Admin role records are never publicly readable/writable.
    // A signed-in admin can read only their own role document.
    // Creation/changes should be done manually in Firebase Console
    // or through a trusted backend, not from this client.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    // Deny every other document path by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
